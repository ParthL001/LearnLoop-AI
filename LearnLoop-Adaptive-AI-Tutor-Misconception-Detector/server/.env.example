# LearnLoop AI Backend Environment Configuration

# Server Port
PORT=5000

# Client Application Origin for Restricted CORS
CLIENT_ORIGIN=http://localhost:5173

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Ollama HTTP Request Timeout in milliseconds (accounts for cold model loading)
OLLAMA_TIMEOUT_MS=60000
